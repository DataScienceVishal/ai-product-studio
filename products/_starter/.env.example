# Variable names only. Real values go in the cloud environment, GitHub secrets or Azure, never in git.
ENV=dev
DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/starter_dev
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
REQUIRE_EMAIL_VERIFICATION=false

AI_PROVIDER=fake
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_KEY=proxy-injected

BILLING_PROVIDER=mock
BILLING_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=

LOG_LEVEL=INFO
