# Variable names only. Real values go in the cloud environment, GitHub secrets or Azure, never in git.
ENV=dev
DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/starter_dev
# password (default): the URL carries the password. entra: no password in the URL; a managed-identity token is the
# password (URL needs sslmode=verify-full, see README "Entra ID database sign-in"). AZURE_CLIENT_ID picks a user-assigned identity.
DB_AUTH=password
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
# Empty = in-memory rate limits (one replica). redis:// or rediss:// shares them across replicas (secret: has a password)
RATE_LIMIT_REDIS_URL=
# The next two only matter when RATE_LIMIT_REDIS_URL is set.
RATE_LIMIT_REDIS_THREADS=8
RATE_LIMIT_REDIS_QUEUE_TIMEOUT=1.0
# true unless no real email is sent (the outbox); local dev and the e2e test set false
REQUIRE_EMAIL_VERIFICATION=true

AI_PROVIDER=fake
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
# auto (default): responses if the endpoint ends in /openai/v1/responses, else chat. Reasoning deployments need responses.
AZURE_OPENAI_API=auto
AZURE_OPENAI_API_KEY=proxy-injected
# Optional, responses API only: low, medium, high or xhigh. Leave empty to send nothing (model default).
# gpt-5.4-pro rejects "low" (HTTP 400; it accepts medium, high, xhigh), so medium is its cheapest setting.
# An HTTP 400 on this field is a config error: fix the value, retrying will not help.
AZURE_OPENAI_REASONING_EFFORT=
# Seconds the browser waits before aborting. The app serves it at /api/config and the SPA reads it at startup, so
# this is the only place to set it (no build variable). Max 600.
# The app refuses to start unless AI_DEADLINE_SECONDS (default 25) is at least 2 s below it.
FRONTEND_TIMEOUT_SECONDS=30
# Tokens all tenants together may use per UTC day (trials share half). Tokens x price below x 30 must stay
# within the monthly AI budget (infra/cost-guard.sh checks the Bicep defaults).
AI_GLOBAL_DAILY_TOKENS=100000
# With AI_PROVIDER=azure the app refuses to start when tokens x 30 x price is above this many USD a month (default 6.10).
# AI_MONTHLY_BUDGET_USD=6.10
# Optional explicit blended USD per million tokens. Unset: looked up by AZURE_OPENAI_DEPLOYMENT in app/aicost.py
# (gpt-5-mini 2.00, gpt-5.4-pro 180, ...). A deployment not in that table must set it. A pricier model needs a
# lower AI_GLOBAL_DAILY_TOKENS: 6.10 / (30 x price) x 1,000,000.
# AI_PRICE_PER_MILLION_TOKENS=2.00
# Responses API only: extra output tokens added to each call (and reserved) so reasoning cannot use up the answer.
AI_REASONING_HEADROOM=1500

BILLING_PROVIDER=mock
# BILLING_WEBHOOK_SECRET: leave unset with mock billing (a random one is made); with Stripe, its whsec_ value
STRIPE_SECRET_KEY=
# With Stripe, the EARLY50 offer is created as a coupon in test mode and applied at checkout (see README, Billing)
# true only for demos: the mock "Pay (test)" button grants paid plans (with trial-sized AI allowances)
MOCK_CHECKOUT_ENABLED=false

LOG_LEVEL=INFO
FRONTEND_DIST=
